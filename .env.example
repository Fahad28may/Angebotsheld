# Copy to .env.local for local development. Set the same keys in the
# Vercel project's Environment Variables for production/preview.

# Canonical site URL — used for metadataBase, canonical links, OpenGraph,
# JSON-LD, and the sitemap. See app/lib/siteConfig.ts.
NEXT_PUBLIC_SITE_URL=https://angebotsheld24.de

# Resend (https://resend.com) — powers the Pro waitlist signup at
# /api/waitlist. Create an API key and an Audience in the Resend dashboard,
# then paste both below. Without these set, waitlist signups fail with a
# friendly German error instead of crashing.
RESEND_API_KEY=
RESEND_WAITLIST_AUDIENCE_ID=

# Plausible Analytics (https://plausible.io) — cookie-free, no personal
# data. Set to the domain registered in your Plausible project (usually the
# same as NEXT_PUBLIC_SITE_URL's hostname). Leave empty to disable
# analytics entirely — the app works fully without it.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=angebotsheld24.de
